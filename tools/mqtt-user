#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PLAYBOOK="$ROOT/ansible/playbooks/mqtt-user.yml"

usage() {
  cat <<'EOF'
Usage:
  tools/mqtt-user add USER [--read TOPIC] [--write TOPIC] [--rw TOPIC]...
  tools/mqtt-user passwd USER
  tools/mqtt-user remove USER

Examples:
  tools/mqtt-user add evcc --write 'evcc/#'
  tools/mqtt-user add go-echarger --write 'go-eCharger/#'
  tools/mqtt-user add homey --read 'go-eCharger/#' --read 'evcc/#' --write 'homey/#'
  tools/mqtt-user passwd evcc
  tools/mqtt-user remove evcc

The password is prompted without echo. For add/remove operations the variables are
written to a mode-0600 temporary JSON file so Ansible receives ACL topics as real
lists, including topics containing # or +. The file is removed after the run.
Use --ask-vault-pass for Bergen Platform vault variables required by inventory/group_vars.
EOF
}

[[ $# -ge 2 ]] || { usage; exit 2; }
action="$1"; shift
user="$1"; shift

read_topics=()
write_topics=()
rw_topics=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --read)  [[ $# -ge 2 ]] || exit 2; read_topics+=("$2"); shift 2 ;;
    --write) [[ $# -ge 2 ]] || exit 2; write_topics+=("$2"); shift 2 ;;
    --rw)    [[ $# -ge 2 ]] || exit 2; rw_topics+=("$2"); shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage; exit 2 ;;
  esac
done

json_array() {
  python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "$@"
}

run_playbook_with_json() {
  local state="$1"
  local password="${2-}"
  local read_json write_json rw_json extra_file

  read_json="$(json_array "${read_topics[@]}")"
  write_json="$(json_array "${write_topics[@]}")"
  rw_json="$(json_array "${rw_topics[@]}")"

  extra_file="$(mktemp)"
  chmod 600 "$extra_file"
  trap 'rm -f "$extra_file"' EXIT

  python3 - "$extra_file" "$user" "$state" "$password" "$read_json" "$write_json" "$rw_json" <<'PY'
import json
import sys

path, user, state, password, read_json, write_json, rw_json = sys.argv[1:]
data = {
    "mqtt_user_name": user,
    "mqtt_user_state_input": state,
    "mqtt_user_read_topics_input": json.loads(read_json),
    "mqtt_user_write_topics_input": json.loads(write_json),
    "mqtt_user_readwrite_topics_input": json.loads(rw_json),
}
if state == "present":
    data["mqtt_user_password"] = password
with open(path, "w", encoding="utf-8") as fh:
    json.dump(data, fh)
PY

  ansible-playbook -i "$ROOT/ansible/inventory.yml" "$PLAYBOOK" \
    --ask-vault-pass --extra-vars "@$extra_file"
}

case "$action" in
  add)
    read -rsp "MQTT password for $user: " password; echo
    read -rsp "Repeat password: " password2; echo
    [[ "$password" == "$password2" ]] || { echo "Passwords do not match." >&2; exit 1; }
    [[ -n "$password" ]] || { echo "Password must not be empty." >&2; exit 1; }
    run_playbook_with_json present "$password"
    ;;
  passwd)
    read -rsp "MQTT password for $user: " password; echo
    read -rsp "Repeat password: " password2; echo
    [[ "$password" == "$password2" ]] || { echo "Passwords do not match." >&2; exit 1; }
    [[ -n "$password" ]] || { echo "Password must not be empty." >&2; exit 1; }
    # passwd changes credentials only; preserve the existing ACL fragment.
    exec ansible -i "$ROOT/ansible/inventory.yml" mqtt_nodes -b \
      -m ansible.builtin.command \
      -a "mosquitto_passwd -b /etc/mosquitto/passwd '$user' '$password'" \
      --ask-vault-pass
    ;;
  remove)
    run_playbook_with_json absent
    ;;
  *) echo "Unknown action: $action" >&2; usage; exit 2 ;;
esac
