# Managed by Ansible. Contains the OIDC client secret; root only.
WEBUI_URL={{ open_webui_oidc_public_url }}
OAUTH_CLIENT_ID={{ open_webui_oidc_client_id }}
OAUTH_CLIENT_SECRET={{ vault_open_webui_oidc_client_secret }}
OPENID_PROVIDER_URL={{ open_webui_oidc_discovery_url }}
OPENID_REDIRECT_URI={{ open_webui_oidc_public_url }}/oauth/oidc/callback
OAUTH_PROVIDER_NAME=Synology SSO
OAUTH_SCOPES=openid email groups
OAUTH_USERNAME_CLAIM=username
OAUTH_EMAIL_CLAIM=email
OAUTH_GROUPS_CLAIM=groups
OAUTH_PICTURE_CLAIM=
OAUTH_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
OAUTH_CODE_CHALLENGE_METHOD=S256
ENABLE_LOGIN_FORM=true
OAUTH_AUTO_REDIRECT=false
ENABLE_OAUTH_SIGNUP=true
DEFAULT_USER_ROLE=pending
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=false
ENABLE_OAUTH_ROLE_MANAGEMENT=false
ENABLE_OAUTH_GROUP_MANAGEMENT=false
ENABLE_OAUTH_PERSISTENT_CONFIG=false
