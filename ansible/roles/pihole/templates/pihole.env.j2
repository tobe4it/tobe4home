# Managed by Bergen Platform
# Pi-hole v6 FTL environment. Values set here are authoritative/read-only
# inside the Pi-hole UI until removed from the managed environment.

TZ={{ pihole_timezone }}
FTLCONF_webserver_api_password={{ pihole_web_password | to_json }}
FTLCONF_dns_upstreams={{ pihole_upstreams | join(';') }}
FTLCONF_dns_interface={{ pihole_dns_interface }}
FTLCONF_dns_listeningMode={{ pihole_dns_listening_mode }}
FTLCONF_dns_queryLogging={{ pihole_query_logging | ternary('true', 'false') }}
FTLCONF_dns_dnssec={{ pihole_dnssec | ternary('true', 'false') }}
FTLCONF_misc_dnsmasq_lines={{ pihole_dnsmasq_lines | join(';') | to_json }}
FTLCONF_dhcp_active={{ pihole_dhcp_enabled | ternary('true', 'false') }}
FTLCONF_ntp_ipv4_active={{ pihole_ntp_enabled | ternary('true', 'false') }}
FTLCONF_ntp_ipv6_active={{ pihole_ntp_enabled | ternary('true', 'false') }}
FTLCONF_ntp_sync_active={{ pihole_ntp_enabled | ternary('true', 'false') }}
