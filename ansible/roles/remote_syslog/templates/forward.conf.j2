# Managed by Bergen Platform
# Forward local logs to the central Bergen Syslog collector.

action(
  type="omfwd"
  target="{{ remote_syslog_server }}"
  port="{{ remote_syslog_port }}"
  protocol="{{ remote_syslog_protocol }}"
  action.resumeRetryCount="-1"
  queue.type="linkedList"
  queue.size="{{ remote_syslog_queue_size }}"
)
