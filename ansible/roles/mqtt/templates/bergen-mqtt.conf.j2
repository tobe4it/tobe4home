# Managed by Bergen Platform / Ansible
# Debian's /etc/mosquitto/mosquitto.conf already defines the global
# persistence settings. Keep this include focused on the Bergen listener,
# authentication/ACL and logging to avoid duplicate global directives.

listener {{ mqtt_port }} {{ mqtt_bind_address }}
protocol mqtt

allow_anonymous {{ 'true' if mqtt_allow_anonymous else 'false' }}

{% if not mqtt_allow_anonymous %}
password_file {{ mqtt_password_file }}
acl_file {{ mqtt_acl_file }}
{% endif %}

log_dest syslog
log_type error
log_type warning
log_type notice
log_type information

connection_messages true
