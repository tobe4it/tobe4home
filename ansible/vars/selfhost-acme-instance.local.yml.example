---
# EXAMPLE ONLY. Copy to selfhost-acme-<instance>.local.yml (Git-ignored).
# Each installation may use ONE instance or several, with independent slots.
# Never commit real domains, DNS record IDs, authoritative servers, or emails.
selfhost_acme_instance: CHANGE_ME_UNIQUE_INSTANCE_SLUG
selfhost_acme_zone: CHANGE_ME_DNS_ZONE
selfhost_acme_record_ids:
  - CHANGE_ME_RECORD_ID_ONE
  - CHANGE_ME_RECORD_ID_TWO
selfhost_acme_nameservers:
  - CHANGE_ME_AUTHORITATIVE_NS_ONE
  - CHANGE_ME_AUTHORITATIVE_NS_TWO
selfhost_acme_contact_email: CHANGE_ME_ACME_CONTACT_EMAIL
# Optional and scoped to the DNS API HTTPS endpoint, not the whole host:
# selfhost_acme_tls_rsa2048_compat: true
